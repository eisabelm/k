[Unit]
Description=VideoStream Backend Server
After=network.target

[Service]
Type=simple
User=kali
WorkingDirectory=/var/www/videostream
ExecStart=/usr/bin/node /var/www/videostream/dist/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=5000

# Logging
StandardOutput=append:/var/www/videostream/logs/out.log
StandardError=append:/var/www/videostream/logs/err.log
SyslogIdentifier=videostream

# Limits
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target