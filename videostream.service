[Unit]
Description=VideoStream Backend Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/var/www/videostream
ExecStart=/usr/bin/node /var/www/videostream/dist/index.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=PORT=5000

[Install]
WantedBy=multi-user.target